<Project>

  <!--
    Chain to the repo-root Directory.Build.props (centralizes
    WindowsAppSDK version, etc.) — MSBuild stops walking up after the
    first match, so we have to import the parent explicitly.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Default <ApplicationIcon> for every sample project — gives File
    Explorer / taskbar / Alt-Tab a real glyph instead of the generic
    .NET console icon. Samples that ship their own .ico (chat,
    demo-script-tool) set <ApplicationIcon> explicitly in their csproj
    and override this default.

    The path uses $(MSBuildThisFileDirectory) so it's stable regardless
    of how deep under samples/ a csproj lives. WinUI.ico is the official
    WinUI logo, copied from microsoft-ui-xaml-lift (MIT-licensed).

    Library csprojs (OutputType=Library) inherit this too; the .NET SDK
    silently ignores ApplicationIcon for non-executable outputs, so this
    is harmless.
  -->
  <PropertyGroup>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == ''">$(MSBuildThisFileDirectory)Assets\WinUI.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' And '$(ReactorDevtoolsManaged)' != 'false' And $([System.String]::Copy('$(TargetFramework)').Contains('-windows')) And !$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\samples\apps\hello-world-aot'))">
    <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport"
                                    Value="true"
                                    Trim="true" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Reactor.Devtools\Reactor.Devtools.csproj" />
  </ItemGroup>

  <!--
    Run the customer-facing analyzer bundle over the samples.

    Samples ARE consumer code, so the rules that `src/Reactor/Reactor.csproj`
    deliberately opts out of (they would fire spuriously on framework
    internals) are exactly the rules we want here. Consumers get these through
    the NuGet `analyzers/dotnet/cs` path, but samples consume Reactor via
    ProjectReference and packed analyzer DLLs do not flow across one — so
    without this the whole sample tree is unanalyzed. That gap let a
    `.Set(tb => tb.KeyDown += ...)` double-subscribe (REACTOR_EVENT_001) and
    several `.Set(b => b.RequestedTheme = ...)` (REACTOR_THEME_003) sit in the
    samples unreported.

    Opt out per-project with <ReactorSampleAnalyzers>false</ReactorSampleAnalyzers>.
    samples/apps/a11y-showcase wires this itself and is excluded to avoid a
    duplicate analyzer reference.
  -->
  <ItemGroup Condition="'$(ReactorSampleAnalyzers)' != 'false' And !$([System.String]::Copy('$(MSBuildProjectDirectory)').Contains('\samples\apps\a11y-showcase'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Reactor.Analyzers\Reactor.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
